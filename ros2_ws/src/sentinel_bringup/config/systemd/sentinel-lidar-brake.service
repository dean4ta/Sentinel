[Unit]
Description=Sentinel RPLIDAR A1 motor brake (DTR HIGH when idle)
After=dev-sentinel_lidar.device
BindsTo=dev-sentinel_lidar.device

[Service]
User=sentinel1
ExecStart=/usr/bin/python3 /home/sentinel1/dean/Sentinel/ros2_ws/src/sentinel_bringup/scripts/lidar_motor_brake.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
