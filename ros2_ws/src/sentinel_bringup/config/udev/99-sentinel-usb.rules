# Sentinel 1 fixed USB device names. Match VID:PID (+ serial/port where
# two of the same chip exist) and symlink to a stable /dev name so
# launch files never depend on enumeration order.
#
# Install on the Orin:
#   sudo cp 99-sentinel-usb.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Verify: ls -l /dev/sentinel_*

# Raspberry Pi Pico motor controller (USB CDC serial). Serial-matched:
# a second Pico on the bus must not steal the name.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="000a", ATTRS{serial}=="E660D4A0A7695B37", SYMLINK+="sentinel_pico", MODE="0666"

# RPLIDAR A1 (Silicon Labs CP210x UART bridge). Match any CP2102 that is
# NOT one of the arm's: the old arm's programmed serial, or the current
# arm's hub port (1-1.2.4). If the lidar moves to another port it still
# matches; if the arm moves ports it stops matching this rule.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}!="1251dd7e061cef1185f9a0d94909ffd0", KERNELS!="1-1.2.4*", SYMLINK+="sentinel_lidar", MODE="0666"

# Logitech C270 webcam. index 0 = capture node (index 1 = metadata),
# so the symlink always lands on the node a camera client should open.
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="0825", ATTR{index}=="0", SYMLINK+="sentinel_webcam", MODE="0666"

# Robot arm (RoArm-M2-S): CP2102N. Two possible identities:
# - old arm: programmed serial 1251dd7e (survives any port)
# - new arm: unprogrammed (serial 0001, same as lidar), distinguished
#   only by its hub port 1-1.2.4. If its cable moves ports, program its
#   serial (Silicon Labs tool) and drop the port match.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", ATTRS{serial}=="1251dd7e061cef1185f9a0d94909ffd0", SYMLINK+="sentinel_arm", MODE="0666"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", KERNELS=="1-1.2.4*", SYMLINK+="sentinel_arm", MODE="0666"
