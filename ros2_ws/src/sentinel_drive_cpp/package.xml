<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sentinel_drive_cpp</name>
  <version>0.1.0</version>
  <description>C++ ports of the Sentinel 1 drive nodes (cmd_vel_serial,
  wheel_slip_detector, wheel_odometry). Same params (drive_params.yaml),
  same topics, same behavior as the Python originals in sentinel_drive.</description>
  <maintainer email="dean@example.com">Dean Fortier</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sentinel_msgs</depend>
  <depend>eigen3_cmake_module</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sentinel_drive</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
